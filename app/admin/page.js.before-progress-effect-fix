              <p>
                Loading topics…
              </p>

            )}


            {!loadingTopics &&
              topics.length === 0 && (

                <div className="card">

                  <h3>
                    No topics yet
                  </h3>

                  <p className="muted">
                    Add your first topic.
                  </p>

                </div>

              )}


            {!loadingTopics &&
              topics.map(topic => (

                <div
                  className={
                    editing === topic.id
                      ? 'listRow selectedTopic'
                      : 'listRow'
                  }
                  key={topic.id}
                >

                  <div>

                    <b>
                      {topic.code}{' '}
                      {topic.title}
                    </b>

                    <small>
                      Unit {topic.unitCode}

                      {topic.parentId
                        ? ` • Parent: ${topic.parentId}`
                        : ''}
                    </small>

                    <small>

                      {topic.introduction ||
                      topic.explanation ||
                      topic.codeExample
                        ? '✓ Lesson content added'
                        : '○ Lesson content empty'}

                    </small>

                  </div>


                  <div className="topicActions">

                    <button
                      onClick={() =>
                        editTopic(topic)
                      }
                    >
                      Edit
                    </button>

                    <button
                      className="danger"
                      onClick={() =>
                        remove(topic.id)
                      }
                    >
                      Delete
                    </button>

                  </div>

                </div>

              ))}

          </section>

        </div>

      </main>

    </>

  );

