================================================= */}

{editing && (
  <section className="labAdminPanel">

    <div className="labAdminHeader">

      <div>
        <h2>
          Lab Practice & Official Solutions
        </h2>

        <p className="muted">
          {form.code} {form.title}
        </p>
      </div>

    </div>


    {loadingLabs && (
      <p className="muted">
        Loading lab problems…
      </p>
    )}


    {!loadingLabs && labProblems.length === 0 && (
      <div className="card">

        <p className="muted">
          No lab problems are assigned to this topic.
        </p>

      </div>
    )}


    {!loadingLabs &&
      labProblems.map((problem) => (

        <div
          key={problem.id}
          className="labAdminCard"
        >

          <div className="labAdminProblem">

            <div>

  <div className="labProblemMeta">

    <span className="problemTypeBadge">

      {problem.problemType === 'placement'
        ? '🏆 Placement Problem'
        : '🧪 Lab Program'}

    </span>

    <span className="difficultyBadge">

      {problem.difficulty || 'easy'}

    </span>

  </div>


  <strong>
    {problem.title}
  </strong>


  <p>
    {problem.problem}
  </p>

</div>

            <div className="solutionControls">

              <button
                type="button"
                className={
                  problem.visible
                    ? 'solutionOn'
                    : 'solutionOff'
                }
                onClick={() =>
                  toggleSolution(problem)
                }
              >

                {problem.visible
                  ? '● Solution ON'
                  : '○ Solution OFF'}

              </button>


              <button
                type="button"
                className="secondary"
                onClick={() =>
                  editSolution(problem)
                }
              >
                Edit Solution
              </button>

            </div>

          </div>


          {editingSolution === problem.id && (

            <div className="solutionEditor">

              <h3>
                Edit Official Solution
              </h3>


              <input
                value={solutionTitle}
                onChange={(e) =>
                  setSolutionTitle(e.target.value)
                }
                placeholder="Solution title"
              />
                 <div className="problemSettings">

  <div className="problemSetting">

    <label>
      <strong>Problem Type</strong>
    </label>

    <select
      value={problemType}
      onChange={(e) =>
        setProblemType(e.target.value)
      }
    >
      <option value="lab">
        🧪 Lab Program
      </option>

      <option value="placement">
        🏆 Placement Problem
      </option>
    </select>

  </div>


  <div className="problemSetting">

    <label>
      <strong>Difficulty</strong>
    </label>

    <select
      value={problemDifficulty}
      onChange={(e) =>
        setProblemDifficulty(e.target.value)
      }
    >
      <option value="easy">
        Easy
      </option>

      <option value="medium">
        Medium
      </option>

      <option value="hard">
        Hard
      </option>
    </select>

  </div>

</div>

              <Editor
                height="280px"
                value={solutionCode}
                onChange={(value) =>
                  setSolutionCode(value || '')
                }
              />


              <div className="cmsActions">

                <button
                  type="button"
                  onClick={() =>
                    saveSolution(problem)
                  }
                >
                  Save Solution
                </button>


                <button
                  type="button"
                  className="secondary"
                  onClick={() =>
                    setEditingSolution(null)
                  }
                >
                  Cancel
                </button>

              </div>

            </div>

          )}

        </div>

      ))
    }

  </section>
)}


