'use client';

import { useEffect, useMemo, useState } from 'react';

import { auth, db } from '../../lib/firebase';

import {
  onAuthStateChanged,
  getIdTokenResult,
} from 'firebase/auth';

import {
  collection,
  getDocs,
  getDoc,
  doc,
  setDoc,
  deleteDoc,
  serverTimestamp,
  query,
  orderBy,
  where,
} from 'firebase/firestore';

import Header from '../../components/Header';
import Editor from '../../components/Editor';


const emptyForm = {
  unitCode: '',
  unitTitle: '',
  code: '',
  title: '',
  parentId: '',
  order: 0,

  // Lesson
  introduction: '',
  learningObjectives: '',
  explanation: '',
  keyPoints: '',

  // Example
  exampleTitle: '',
  exampleExplanation: '',
  codeExample: '',
  expectedOutput: '',

  // Practice
  practiceQuestion: '',
  practiceInstructions: '',
  practiceStarterCode: '',

  // Additional
  importantNotes: '',
  summary: '',
};


export default function Admin() {

  const [user, setUser] = useState(null);
  const [isAdmin, setIsAdmin] = useState(false);
  const [checkingAuth, setCheckingAuth] = useState(true);

  const [topics, setTopics] = useState([]);
  const [labProblems, setLabProblems] = useState([]);
  const [loadingLabs, setLoadingLabs] = useState(false);

  // =========================================================
  // STUDENT PROGRESS
  // =========================================================

  const [studentProgress, setStudentProgress] = useState([]);
  const [loadingStudentProgress, setLoadingStudentProgress] = useState(false);

  // =========================================================
  // SELECTED STUDENT FOR UNIT-WISE PROGRESS
  // =========================================================

  const [selectedProgressStudent, setSelectedProgressStudent] =
    useState(null);
  const [editingSolution, setEditingSolution] = useState(null);
  const [solutionCode, setSolutionCode] = useState('');
  const [solutionTitle, setSolutionTitle] = useState('');
  const [solutionProblem, setSolutionProblem] = useState('');
const [problemType, setProblemType] =
  useState('lab');

const [problemDifficulty, setProblemDifficulty] =
  useState('easy');






  const [editing, setEditing] = useState(null);
  const [form, setForm] = useState(emptyForm);

  const [error, setError] = useState('');
  const [success, setSuccess] = useState('');

  const [loadingTopics, setLoadingTopics] = useState(false);
  const [preview, setPreview] = useState(false);


  // =========================================================
  // AUTHENTICATION
  // =========================================================

  useEffect(() => {

    const unsubscribe = onAuthStateChanged(
      auth,
      async (currentUser) => {

        setCheckingAuth(true);
        setError('');
        setSuccess('');

        setUser(currentUser);

        if (!currentUser) {
          setIsAdmin(false);
          setCheckingAuth(false);
          return;
        }

        try {

          const tokenResult =
            await getIdTokenResult(
              currentUser,
              true
            );

          const adminClaim =
            tokenResult.claims.admin === true;

          setIsAdmin(adminClaim);

          if (!adminClaim) {

            setError(
              'Your Google account is signed in, but it does not have Admin permission.'
            );

            setCheckingAuth(false);
            return;
          }

          await loadTopics();

        } catch (err) {

          console.error(
            'Admin authentication error:',
            err
          );

          setIsAdmin(false);

          setError(
            err?.message ||
            'Unable to verify administrator access.'
          );

        }

        setCheckingAuth(false);
      }
    );

    return () => unsubscribe();

  }, []);


  // =========================================================
  // LOAD TOPICS
  // =========================================================

  async function loadTopics() {

    try {

      setLoadingTopics(true);
      setError('');

      const topicsQuery = query(
        collection(db, 'topics'),
        orderBy('order')
      );

      const snapshot =
        await getDocs(topicsQuery);

      const data =
        snapshot.docs.map(document => ({
          id: document.id,
          ...document.data(),
        }));

      setTopics(data);

    } catch (err) {

      console.error(
        'Unable to load topics:',
        err
      );

      setError(
        err?.message ||
        'Unable to load topics from Firestore.'
      );

    } finally {

      setLoadingTopics(false);

    }

  }

// =========================================================
// LOAD LAB PROBLEMS / SOLUTIONS
// =========================================================

async function loadLabProblems(topicCode) {
  if (!topicCode) {
    setLabProblems([]);
    return;
  }

  try {
    setLoadingLabs(true);
    setError('');

    const q = query(
      collection(db, 'topicSolutions'),
      where('topicCode', '==', topicCode)
    );

    const snapshot = await getDocs(q);

    const data = snapshot.docs
  .map((document) => ({
    id: document.id,
    ...document.data(),

    problemType:
      document.data().problemType || 'lab',

    difficulty:
      document.data().difficulty || 'easy',

    testCases:
      Array.isArray(document.data().testCases)
        ? document.data().testCases
        : [],
  }))
  .sort(
    (a, b) =>
      (a.order || 0) -
      (b.order || 0)
  );
    setLabProblems(data);
  } catch (err) {
    console.error('Unable to load lab problems:', err);

    setError(
      err?.message ||
      'Unable to load lab problems.'
    );

    setLabProblems([]);
  } finally {
    setLoadingLabs(false);
  }
}



// =========================================================
// SAVE OFFICIAL SOLUTION
// =========================================================

async function saveSolution(problem) {
  try {
    setError('');
    setSuccess('');
   await setDoc(
  doc(db, 'topicSolutions', problem.id),
  {
    title: solutionTitle,
    problem: solutionProblem,
    solution: solutionCode,

    problemType:
      problemType || 'lab',

    difficulty:
      problemDifficulty || 'easy',

    updatedAt: serverTimestamp(),
  },
      {
        merge: true,
      }
    );

    setSuccess(
      `${problem.title} solution saved successfully.`
    );

    setEditingSolution(null);

    await loadLabProblems(problem.topicCode);

  } catch (err) {
    console.error(
      'Save solution error:',
      err
    );

    setError(
      err?.message ||
      'Unable to save the solution.'
    );
  }
}

// =========================================================
// EDIT OFFICIAL SOLUTION
// =========================================================

function editSolution(problem) {

  setError('');
  setSuccess('');

  setEditingSolution(problem.id);

  setSolutionTitle(
    problem.title || ''
  );

  setSolutionProblem(
    problem.problem || ''
  );

  setSolutionCode(
    problem.solution || ''
  );

  setProblemType(
    problem.problemType || 'lab'
  );

  setProblemDifficulty(
    problem.difficulty || 'easy'
  );
}

// =========================================================
// TOGGLE SOLUTION VISIBILITY
// =========================================================

async function toggleSolution(problem) {

  try {

    setError('');
    setSuccess('');

    const newVisibility =
      !Boolean(problem.visible);

    await setDoc(
      doc(
        db,
        'topicSolutions',
        problem.id
      ),
      {
        visible: newVisibility,

        updatedAt:
          serverTimestamp(),

      },
      {
        merge: true,
      }
    );

    setSuccess(
      newVisibility
        ? `${problem.title}: solution is now visible to students.`
        : `${problem.title}: solution is now hidden from students.`
    );

    await loadLabProblems(
      problem.topicCode
    );

  } catch (err) {

    console.error(
      'Toggle solution error:',
      err
    );

    setError(
      err?.message ||
      'Unable to change solution visibility.'
    );

  }

}






  // =========================================================
  // FORM HELPER
  // =========================================================

  function updateForm(field, value) {

    setForm(previous => ({
      ...previous,
      [field]: value,
    }));

  }


  // =========================================================
  // SAVE TOPIC
  // =========================================================

  async function save(e) {

    e.preventDefault();

    setError('');
    setSuccess('');

    try {

      const data = {

        unitCode: form.unitCode || '',
        unitTitle: form.unitTitle || '',

        code: form.code || '',
        title: form.title || '',

        parentId: form.parentId || '',

        order: Number(form.order || 0),

        // =================================================
        // LESSON CONTENT
        // =================================================

        introduction:
          form.introduction || '',

        learningObjectives:
          form.learningObjectives || '',

        explanation:
          form.explanation || '',

        keyPoints:
          form.keyPoints || '',

        // =================================================
        // EXAMPLE
        // =================================================

        exampleTitle:
          form.exampleTitle || '',

        exampleExplanation:
          form.exampleExplanation || '',

        codeExample:
          form.codeExample || '',

        expectedOutput:
          form.expectedOutput || '',

        // =================================================
        // PRACTICE
        // =================================================

        practiceQuestion:
          form.practiceQuestion || '',

        practiceInstructions:
          form.practiceInstructions || '',

        practiceStarterCode:
          form.practiceStarterCode || '',

        // =================================================
        // ADDITIONAL
        // =================================================

        importantNotes:
          form.importantNotes || '',

        summary:
          form.summary || '',

        updatedAt:
          serverTimestamp(),
      };


      if (editing) {

        await setDoc(
          doc(db, 'topics', editing),
          data,
          { merge: true }
        );

      } else {

        await setDoc(
          doc(db, 'topics', form.code),
          {
            ...data,
            createdAt:
              serverTimestamp(),
          }
        );

      }


      setSuccess(
        `${form.code} ${form.title} saved successfully.`
      );

      setEditing(null);
      setForm(emptyForm);

      await loadTopics();

    } catch (err) {

      console.error(
        'Save topic error:',
        err
      );

      setError(
        err?.message ||
        'Unable to save the topic.'
      );

    }

  }


  // =========================================================
  // DELETE TOPIC
  // =========================================================

  async function remove(id) {

    const confirmed =
      window.confirm(
        'Delete this topic? This cannot be undone.'
      );

    if (!confirmed) return;

    try {

      setError('');
      setSuccess('');

      await deleteDoc(
        doc(db, 'topics', id)
      );

      setSuccess(
        'Topic deleted successfully.'
      );

      await loadTopics();

    } catch (err) {

      console.error(
        'Delete topic error:',
        err
      );

      setError(
        err?.message ||
        'Unable to delete the topic.'
      );

    }

  }


  // =========================================================
  // EDIT TOPIC
  // =========================================================

  function editTopic(topic) {

    setEditing(topic.id);

    setPreview(false);

    loadLabProblems(topic.code); 

    setForm({

      unitCode:
        topic.unitCode || '',

      unitTitle:
        topic.unitTitle || '',

      code:
        topic.code || '',

      title:
        topic.title || '',

      parentId:
        topic.parentId || '',

      order:
        topic.order || 0,

      introduction:
        topic.introduction || '',

      learningObjectives:
        topic.learningObjectives || '',

      explanation:
        topic.explanation || '',

      keyPoints:
        topic.keyPoints || '',

      exampleTitle:
        topic.exampleTitle || '',

      exampleExplanation:
        topic.exampleExplanation || '',

      codeExample:
        topic.codeExample || '',

      expectedOutput:
        topic.expectedOutput || '',

      practiceQuestion:
        topic.practiceQuestion || '',

      practiceInstructions:
        topic.practiceInstructions || '',

      practiceStarterCode:
        topic.practiceStarterCode || '',

      importantNotes:
        topic.importantNotes || '',

      summary:
        topic.summary || '',
    });

    window.scrollTo({
      top: 0,
      behavior: 'smooth',
    });

  }



  // =========================================================
  // LOAD STUDENT PROGRESS
  // =========================================================

  useEffect(() => {

    if (!user?.uid || !isAdmin) {
      setStudentProgress([]);
      return;
    }

    let cancelled = false;

    async function loadStudentProgress() {

      setLoadingStudentProgress(true);

      try {

        // ---------------------------------------------------------
        // LOAD ALL REGISTERED USERS
        // ---------------------------------------------------------

        const usersSnapshot = await getDocs(
          collection(db, 'users')
        );

        if (cancelled) return;


        // ---------------------------------------------------------
        // LOAD ALL RECORDED PROGRESS
        // ---------------------------------------------------------

        const progressSnapshot = await getDocs(
          collection(db, 'studentProgress')
        );

        if (cancelled) return;


        const progressByUid = {};

        progressSnapshot.docs.forEach((document) => {

          const data = document.data();

          const uid =
            data.uid || document.id;

          progressByUid[uid] = data;

        });


        // ---------------------------------------------------------
        // BUILD STUDENT LIST
        // ---------------------------------------------------------

        const progress = usersSnapshot.docs
          .map((document) => {

            const profile =
              document.data();

            const uid =
              profile.uid || document.id;


            // Exclude administrator accounts.
            if (
              profile.admin === true ||
              profile.rollNumber === 'admin'
            ) {
              return null;
            }


            const progressData =
              progressByUid[uid] || {};

            const recordedTopics =
              progressData.topics || {};

            // Actual syllabus topics loaded from Firestore.
            const totalTopics =
              topics.length;

            const completed =
              topics.filter(
                (topic) =>
                  recordedTopics[topic.id]?.completed === true
              ).length;


            return {

              uid,

              name:
                profile.name ||
                profile.displayName ||
                profile.fullName ||
                'Student',

              email:
                profile.email ||
                '',

              rollNumber:
                profile.rollNumber ||
                '',

              topics:
                totalTopics,

              topicProgress:
                recordedTopics,

              completed,

              remaining:
                Math.max(
                  totalTopics - completed,
                  0
                ),

              percentage:
                totalTopics > 0
                  ? Math.round(
                      (completed / totalTopics) * 100
                    )
                  : 0,

            };

          })
          .filter(Boolean);


        // ---------------------------------------------------------
        // SORT BY STUDENT NAME
        // ---------------------------------------------------------

        progress.sort(
          (a, b) =>
            a.name.localeCompare(
              b.name
            )
        );


        setStudentProgress(progress);

        console.log(
          'ADMIN STUDENT PROGRESS:',
          progress
        );

      } catch (error) {

        console.error(
          'Student progress loading error:',
          error
        );

        if (!cancelled) {
          setStudentProgress([]);
        }

      } finally {

        if (!cancelled) {
          setLoadingStudentProgress(false);
        }

      }

    }

    loadStudentProgress();

    return () => {
      cancelled = true;
    };

  }, [user?.uid, isAdmin]);


  // =========================================================
  // ADMIN DASHBOARD
  // =========================================================

  // =========================================================
  // STUDENT PROGRESS SUMMARY
  // =========================================================

  const studentProgressSummary = useMemo(() => {

    const totalStudents =
      studentProgress.length;

    const completedStudents =
      studentProgress.filter(
        student =>
          student.percentage === 100
      ).length;

    const inProgressStudents =
      studentProgress.filter(
        student =>
          student.percentage > 0 &&
          student.percentage < 100
      ).length;

    const notStartedStudents =
      studentProgress.filter(
        student =>
          student.percentage === 0
      ).length;

    const averageProgress =
      totalStudents > 0
        ? Math.round(
            studentProgress.reduce(
              (sum, student) =>
                sum + student.percentage,
              0
            ) / totalStudents
          )
        : 0;

    return {
      totalStudents,
      completedStudents,
      inProgressStudents,
      notStartedStudents,
      averageProgress,
    };

  }, [studentProgress]);



  // =========================================================
  // NEW TOPIC
  // =========================================================

  function newTopic() {
  setEditing(null);
  setPreview(false);
  setForm(emptyForm);

  setLabProblems([]);
  setEditingSolution(null);

  window.scrollTo({
    top: 0,
    behavior: 'smooth',
  });
}

  // =========================================================
  // CANCEL
  // =========================================================

 function cancelEdit() {
  setEditing(null);
  setPreview(false);
  setForm(emptyForm);

  setLabProblems([]);
  setEditingSolution(null);
}

  // =========================================================
  // AUTH CHECK
  // =========================================================

  if (checkingAuth) {

    return (

      <main className="center">

        <div className="card">

          <h2>
            Checking administrator access…
          </h2>

          <p className="muted">
            Please wait.
          </p>

        </div>

      </main>

    );

  }


  if (!user) {

    return (

      <main className="center">

        <div className="card">

          <h2>
            Sign in first.
          </h2>

          <p className="muted">
            Please sign in with your Google account.
          </p>

        </div>

      </main>

    );

  }


  if (!isAdmin) {

    return (

      <main className="center">

        <div className="card">

          <h2>
            Administrator access required
          </h2>

          <p className="muted">

            {error ||
              'Your account does not have administrator permission.'}

          </p>

          <p className="muted">

            Signed in as:
            <br />

            <b>
              {user.email}
            </b>

          </p>

        </div>

      </main>

    );

  }



  return (

    <>

      <Header
        profile={{
          admin: true,
          email: user.email,
        }}
      />

      <main className="admin">

        {/* =========================================================
            STUDENT PROGRESS DASHBOARD
        ========================================================= */}

        <section
          className="adminSection studentProgressDashboard"
          id="studentProgressDashboard"
        >

          <div className="adminSectionHeader">

            <div>

              <h2>
                📊 Student Progress
              </h2>

              <p className="muted">
                Monitor topic completion and learning progress.
              </p>

            </div>

            {loadingStudentProgress && (
              <span className="muted">
                Loading progress…
              </span>
            )}

          </div>


          {/* SUMMARY */}

          <div className="adminStatsGrid">

            <div className="adminStatCard">
              <span className="adminStatLabel">
                👥 Total Students
              </span>
              <strong className="adminStatValue">
                {studentProgressSummary.totalStudents}
              </strong>
            </div>


            <div className="adminStatCard">
              <span className="adminStatLabel">
                ✅ Completed
              </span>
              <strong className="adminStatValue">
                {studentProgressSummary.completedStudents}
              </strong>
            </div>


            <div className="adminStatCard">
              <span className="adminStatLabel">
                🟡 In Progress
              </span>
              <strong className="adminStatValue">
                {studentProgressSummary.inProgressStudents}
              </strong>
            </div>


            <div className="adminStatCard">
              <span className="adminStatLabel">
                ⚪ Not Started
              </span>
              <strong className="adminStatValue">
                {studentProgressSummary.notStartedStudents}
              </strong>
            </div>


            <div className="adminStatCard">
              <span className="adminStatLabel">
                📈 Average Progress
              </span>
              <strong className="adminStatValue">
                {studentProgressSummary.averageProgress}%
              </strong>
            </div>

          </div>


          {/* =====================================================
              UNIT-WISE STUDENT DETAIL
          ===================================================== */}

          {selectedProgressStudent && (

            <section className="adminSection">

              <div className="adminSectionHeader">

                <div>

                  <h2>
                    👤 {selectedProgressStudent.name}
                  </h2>

                  <p className="muted">

                    {selectedProgressStudent.email || 'No email'}
                    {' • '}
                    Roll No:
                    {' '}
                    {selectedProgressStudent.rollNumber || '—'}

                  </p>

                </div>

                <button
                  type="button"
                  className="secondary"
                  onClick={() =>
                    setSelectedProgressStudent(null)
                  }
                >
                  Close
                </button>

              </div>


              <div className="card">

                <h3>
                  Overall Progress:
                  {' '}
                  {selectedProgressStudent.percentage}%
                </h3>

                <div className="studentProgressTrack">

                  <div
                    className="studentProgressFill"
                    style={{
                      width:
                        `${selectedProgressStudent.percentage}%`
                    }}
                  />

                </div>

                <p className="muted">

                  {selectedProgressStudent.completed}
                  {' / '}
                  {selectedProgressStudent.topics}
                  {' '}
                  syllabus topics completed.

                </p>

              </div>


              {/* UNIT-WISE BREAKDOWN */}

              <div className="unitProgressList">

                {Object.values(
                  topics.reduce(
                    (units, topic) => {

                      const code =
                        String(topic.unitCode || '');

                      if (!units[code]) {

                        units[code] = {
                          code,
                          title:
                            topic.unitTitle || '',
                          topics: [],
                        };

                      }

                      units[code].topics.push(topic);

                      return units;

                    },
                    {}
                  )
                ).map((unit) => {

                  const completedTopics =
                    unit.topics.filter(
                      (topic) =>
                        selectedProgressStudent
                          .topicProgress?.[topic.id]
                          ?.completed === true
                    );

                  const total =
                    unit.topics.length;

                  const completed =
                    completedTopics.length;

                  const percentage =
                    total > 0
                      ? Math.round(
                          (completed / total) * 100
                        )
                      : 0;

                  return (

                    <details
                      key={unit.code}
                      className="card unitProgressCard"
                    >

                      <summary>

                        <strong>
                          Unit {unit.code}
                          {' — '}
                          {unit.title}
                        </strong>

                        <span>
                          {completed}
                          {' / '}
                          {total}
                          {' '}
                          ({percentage}%)
                        </span>

                      </summary>


                      <div className="unitProgressTrack">

                        <div
                          className="unitProgressFill"
                          style={{
                            width:
                              `${percentage}%`
                          }}
                        />

                      </div>


                      <div className="unitTopicProgressList">

                        {unit.topics.map(
                          (topic) => {

                            const done =
                              selectedProgressStudent
                                .topicProgress?.[topic.id]
                                ?.completed === true;

                            return (

                              <div
                                key={topic.id}
                                className="unitTopicProgressItem"
                              >

                                <span>
                                  {done
                                    ? '✓'
                                    : '○'}
                                </span>

                                <span>

                                  <strong>
                                    {topic.code}
                                  </strong>

                                  {' — '}
                                  {topic.title}

                                </span>

                              </div>

                            );

                          }
                        )}

                      </div>

                    </details>

                  );

                })}

              </div>

            </section>

          )}

          {/* STUDENT TABLE */}

          {studentProgress.length > 0 ? (

            <div className="studentProgressTableWrapper">

              <table className="studentProgressTable">

                <thead>
                  <tr>
                    <th>#</th>
                    <th>Student</th>
                    <th>Email</th>
                    <th>Topics</th>
                    <th>Completed</th>
                    <th>Progress</th>
                    <th>Status</th>
                  </tr>
                </thead>


                <tbody>

                  {studentProgress.map(
                    (student, index) => (

                      <tr
                        key={student.uid}
                        onClick={() =>
                          setSelectedProgressStudent(student)
                        }
                        style={{
                          cursor: 'pointer',
                        }}
                      >

                        <td>
                          {index + 1}
                        </td>

                        <td>
                          <strong>
                            {student.name}
                          </strong>
                        </td>

                        <td>
                          {student.email || '—'}
                        </td>

                        <td>

                          <strong>
                            {student.completed}
                            {' / '}
                            {student.topics}
                          </strong>

                        </td>

                        <td>
                          {student.completed}
                        </td>

                        <td>

                          <div className="studentProgressCell">

                            <div className="studentProgressTrack">

                              <div
                                className="studentProgressFill"
                                style={{
                                  width:
                                    `${student.percentage}%`
                                }}
                              />

                            </div>

                            <span>
                              {student.percentage}%
                            </span>

                          </div>

                        </td>

                        <td>

                          {student.percentage === 100
                            ? '✅ Completed'
                            : student.percentage > 0
                            ? '🟡 In Progress'
                            : '⚪ Not Started'}

                        </td>

                      </tr>

                    )
                  )}

                </tbody>

              </table>

            </div>

          ) : (

            !loadingStudentProgress && (

              <div className="card">

                <p className="muted">
                  No student progress has been recorded yet.
                </p>

              </div>

            )

          )}

        </section>


        <div className="adminTitleRow">

          <div>

            <h1>
              Python Learning — Admin CMS
            </h1>

            <p className="muted">
              Create and manage complete lessons, examples
              and Python practice activities.
            </p>

          </div>

          <button
            type="button"
