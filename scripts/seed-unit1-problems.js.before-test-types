// =========================================================
// GENERATE DETERMINISTIC DOCUMENT ID
// =========================================================

function makeDocumentId(problem) {
  return `problem_${problem.id}`;
}


// =========================================================
// SEED FIRESTORE
// =========================================================

async function seed() {

  console.log(
    `Preparing ${problems.length} problems...`
  );

  let batch = db.batch();
  let count = 0;
  let total = 0;

  for (const problem of problems) {

    const documentId =
      makeDocumentId(problem);

    const ref =
      db.collection('topicSolutions')
        .doc(documentId);

    batch.set(
      ref,
      {
        ...problem,

        updatedAt:
          admin.firestore.FieldValue.serverTimestamp(),
      },
      {
        merge: true,
      }
    );

    count++;
    total++;

    // Firestore batch limit
    if (count === 400) {

      await batch.commit();

      console.log(
        `Committed ${count} problems.`
      );

      batch = db.batch();
      count = 0;

    }

  }

  if (count > 0) {

    await batch.commit();

  }

  console.log(
    `DONE. ${total} problems seeded.`
  );

}


seed()
  .then(() => {
    process.exit(0);
  })
  .catch((error) => {

    console.error(
      'SEED ERROR:',
      error
    );

    process.exit(1);

  });
